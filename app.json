{
  "expo": {
    "name": "Fitzone",
    "slug": "Fitzone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitzone",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitzone.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#000000"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.fitzone.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fitzone_logo.png",
          "resizeMode": "cover",
          "imageSize": 200,
          "backgroundColor": "#000000"
        }
      ],
      "@react-native-google-signin/google-signin",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "windowSoftInputMode": "adjustResize"
          }
        }
      ],
      [
        "expo-image",
        {
          "disableLibdav1d": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "AIzaSyAbJ5zh3WOesnkySmf_T08rjC5R0f-MUhc",
          "androidGoogleMapsApiKey": "AIzaSyAbJ5zh3WOesnkySmf_T08rjC5R0f-MUhc"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}